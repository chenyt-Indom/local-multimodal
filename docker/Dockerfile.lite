# -*- 本地多模态助手 · 精简版应用镜像
# 只含「后端 + 前端 + Python 运行时」，不含模型权重、不含 torch，镜像约 300MB。
# 对话模型由同 compose 里的 ollama 服务提供（首次启动自动拉取）。
# 构建上下文必须是项目根目录：
#   docker build -f docker/Dockerfile.lite -t local-multimodal-lite:latest .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    MM_DATA_DIR=/data

WORKDIR /opt/app

# 运行期依赖：curl 用于健康检查，libgl1/libglib2.0-0 供 Pillow 处理图像
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl libgl1 libglib2.0-0 tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements-app.txt ./
RUN pip install -r requirements-app.txt

COPY backend/ ./backend/
COPY frontend/ ./frontend/

# 运行数据统一落在 /data（记忆库/会话/图片库/日志），由外部卷挂载持久化
RUN mkdir -p /data

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=8 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
