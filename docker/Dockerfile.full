# -*- 本地多模态助手 · 完整自包含镜像
# 内含：Ollama 运行时 + Qwen3-VL 对话模型 + Stable Diffusion 绘图模型 + 超分模型 + 后端前端
# 拷到任何一台机器，不联网即可直接使用。
#
# 构建上下文必须是项目根目录，且需先准备好模型（见 docker/prepare-context.sh）：
#   models/ollama/      → 容器 /root/.ollama/models   （manifests/ + blobs/）
#   models/sd-turbo/    → 容器 /opt/app/sd_model
#   models/esrgan/      → 容器 /opt/app/esrgan
#
# 构建：
#   docker build -f docker/Dockerfile.full -t local-multimodal-full:latest .
# 让绘图走 GPU（体积更大，需目标机有 NVIDIA 显卡）：
#   docker build -f docker/Dockerfile.full \
#     --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu124 \
#     -t local-multimodal-full:latest .
FROM ollama/ollama:latest

# 绘图用的 torch 来源：默认 CPU 版（通用、体积小）；可换成 cu124 走显卡
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
ARG DEBIAN_FRONTEND=noninteractive

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    MM_DATA_DIR=/data \
    OLLAMA_MODELS=/root/.ollama/models \
    OLLAMA_HOST=0.0.0.0 \
    OLLAMA_KEEP_ALIVE=30m \
    SD_MODEL_DIR=/opt/app/sd_model \
    ESRGAN_MODEL=/opt/app/esrgan/RealESRGAN_x4plus.pth

# ---------- Python 运行时 ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 python3-pip python3-venv \
        libgl1 libglib2.0-0 tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/app

# ---------- 应用依赖 ----------
COPY docker/requirements-app.txt ./
RUN pip3 install --no-cache-dir --break-system-packages -r requirements-app.txt

# ---------- 绘图依赖 ----------
# torch 单独从指定源装：--index-url 能确保拿到 +cpu（或 +cu124）版本，
# 若混用 --extra-index-url，pip 可能选到 PyPI 上的 CUDA 版，导致镜像暴涨数 GB。
RUN pip3 install --no-cache-dir --break-system-packages \
        --index-url ${TORCH_INDEX} torch

COPY docker/requirements-image.txt ./
RUN pip3 install --no-cache-dir --break-system-packages -r requirements-image.txt

# ---------- 内置模型权重（离线自包含）----------
# 模型通过独立构建上下文传入（体积大，不放进主上下文）：
#   docker build --build-context models=./build/models -f docker/Dockerfile.full .
# 用 compose 时已在 compose.full.yml 里配好 additional_contexts。
COPY --from=models ollama/ /root/.ollama/models/
COPY --from=models sd-turbo/ /opt/app/sd_model/
COPY --from=models esrgan/ /opt/app/esrgan/

# ---------- 应用代码 ----------
COPY backend/ ./backend/
COPY frontend/ ./frontend/

RUN mkdir -p /data

# ---------- 启动入口（先起 Ollama，再起后端）----------
COPY docker/entrypoint-full.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000 11434

HEALTHCHECK --interval=20s --timeout=5s --start-period=90s --retries=10 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
