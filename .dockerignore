# ---------- 版本控制与文档 ----------
.git/
.gitignore
README.md
*.md

# ---------- PyInstaller 构建产物 ----------
build/
dist/
build-lite/
dist-lite/
releases/

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---------- 运行时可写数据（绝对不能进镜像）----------
data/
sessions/
image_library/
saved_images/
logs/
config.json
docker/data/

# ---------- 残留 / 临时文件 ----------
# 改代码前留的备份（如 frontend/app.js.bak-devdesk）绝不能进镜像：
# 它会被 COPY frontend/ 一起打进去，白白增大体积还容易让人看错文件。
*.bak
*.bak-*
*.orig
*.incomplete
*.tmp
*.log

# ---------- 模型权重 ----------
# 模型体积达 12GB，作为独立构建上下文（--build-context models=./models）单独传入，
# 不放进主上下文，避免精简版构建也白白传输 GB 级数据。
models/

# ---------- 环境与 IDE ----------
.vscode/
.idea/
Thumbs.db
.DS_Store

# 端到端测试用的临时数据目录
.webtest-data/
