# 运行产物
__pycache__/
*.pyc

# 配置（含用户自定义参数，不提交）
config.json

# Docker 模型权重副本（6GB，不入版本库，由构建脚本注入）
docker/models/
docker/data/

# 打包产物
build/exe/
build/warn-*.txt
build/*.pyc
build/本地多模态助手/
build-lite/
dist/
dist-lite/
*.spec.bak

# 改代码前留的本地备份（main.py.bak 这类）—— 只是回滚用，不进版本库
# （.dockerignore 里也有同样两条，别只改一边）
*.bak
*.bak-*

# 端到端测试用的临时数据目录（独立端口验证时用 MM_DATA_DIR 指过来）
.webtest-data/

# 运行时数据（记忆/会话/知识库/保存图片，随各机器独立，不入版本库）
data/

# 虚拟环境
.venv/
venv/

# IDE
.vscode/
.idea/

# 系统
Thumbs.db
.DS_Store
# 运行时生成的图片，不入库
saved_images/

# 会话数据（含聊天记录，属隐私，不入库）
sessions/

# 图片库（用户保存的图片，运行时数据）
image_library/

# 内置 code-server（真正的 VS Code，200MB+，不入版本库）
# 需要时从 https://github.com/coder/code-server/releases 下载 windows-amd64 包
# 解压到 vendor/ 即可（目录名形如 code-server-4.x.x-windows-amd64）
vendor/

# 模型早期用相对路径误写到源码根目录的产物（已加绝对路径防护，不会再产生）
# 留着不动，避免误删用户内容；不纳入版本库
/代码/
/番茄钟/
/网页/

# 构建期离线资源：只保留说明，大文件自己下载（见 docker/vendor-assets/README.md）
docker/vendor-assets/*.tar.gz
bench_30b.txt

# 抠图模型权重（BiRefNet，约 1GB/档位）。运行时按需下载，**不入版本库**；
# 交付包靠 docker/models/rembg 挂载（那条已在上面忽略）。
rembg/

# 抠图 / 合成的一次性验证输出图（本地肉眼检查用，不入库）
_qa_out/
